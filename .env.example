# Digiteka API Configuration (Optional - app works with demo data without these)
DIGITEKA_API_KEY=your_api_key_here
DIGITEKA_BASE_URL=https://api.digiteka.com/v1
DIGITEKA_SITE_ID=your_site_id_here

# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Digiteka Reporting Dashboard

# Note: Leave DIGITEKA_API_KEY empty or set to 'demo_key' to use mock data for demonstration